        }
      ],
      "expected_properties": [
        "nested"
      ],
      "expected": {
        "nested": {
          "kind": "json",
          "value": "json-result"
        }
      },
      "subclass_properties": [
        "nested"
      ],
      "expected_getter_calls": [
        "nested"
      ]
    },
    {
      "name": "number_array_uses_number_array_projection",
      "values": [
        {
          "name": "numbers",
          "kind": "array",
          "conforms_number_array": true,
          "number_array_result": "[0,-1,4294967295]"
        }
      ],
      "expected_properties": [
        "numbers"
      ],
      "expected": {
        "numbers": {
          "kind": "number_array",
          "value": "[0,-1,4294967295]"
        }
      },
      "subclass_properties": [
        "numbers"
      ],
      "expected_getter_calls": [
        "numbers"
      ]
    },
    {
      "name": "ordinary_scalar_zero_is_retained",
