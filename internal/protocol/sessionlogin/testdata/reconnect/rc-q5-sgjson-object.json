{
  "status": "reviewed-static-synthetic",
  "cases": [
    {
      "name": "dynamic_properties_stop_before_sgjsonobject",
      "subclass_properties": [
        "child"
      ],
      "superclass_properties": [
        "base"
      ],
      "values": [
        {
          "name": "child",
          "kind": "scalar",
          "scalar_result": "child-value"
        },
        {
          "name": "base",
          "kind": "scalar",
          "scalar_result": "0"
        }
      ],
      "expected_properties": [
        "child",
        "base"
      ],
      "expected": {
        "child": {
          "kind": "scalar",
          "value": "child-value"
        },
        "base": {
          "kind": "scalar",
          "value": "0"
        }
      },
      "expected_getter_calls": [
        "child",
        "base"
      ]
    },
    {
      "name": "nil_and_nsnull_are_distinct_from_ordinary_string",
      "values": [
        {
          "name": "nil_value",
          "kind": "nil"
        },
        {
          "name": "explicit_nsnull",
          "kind": "nsnull"
        },
        {
          "name": "ordinary",
          "kind": "scalar",
          "scalar_result": "NSNull"
        }
      ],
      "expected_properties": [
        "nil_value",
        "explicit_nsnull",
        "ordinary"
      ],
      "expected": {
        "nil_value": {
          "kind": "nsnull",
          "value": "NSNull"
        },
        "explicit_nsnull": {
          "kind": "nsnull",
          "value": "NSNull"
        },
        "ordinary": {
          "kind": "scalar",
          "value": "NSNull"
        }
      },
      "subclass_properties": [
        "nil_value",
        "explicit_nsnull",
        "ordinary"
      ],
      "expected_getter_calls": [
        "nil_value",
        "explicit_nsnull",
        "ordinary"
      ]
    },
    {
