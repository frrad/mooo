{
  "status": "reviewed-static-framework-bounded-synthetic",
  "platform": "macOS KakaoTalk 26.8.0 arm64 SGJsonKit",
  "cases": [
    {
      "name": "int32_values_boundaries",
      "class": "SGInt32Array",
      "superclass": "SGIntArray",
      "width": 4,
      "values": [
        -2147483648,
        -1,
        0,
        2147483647
      ],
      "expected_data_hex": "00000080ffffffff00000000ffffff7f",
      "expected_count": 4
    },
    {
      "name": "int64_values_boundaries",
      "class": "SGInt64Array",
      "superclass": "SGLongArray",
      "width": 8,
      "values": [
        -9223372036854775808,
        -1,
        0,
        9223372036854775807
      ],
      "expected_data_hex": "0000000000000080ffffffffffffffff0000000000000000ffffffffffffff7f",
      "expected_count": 4
    },
    {
      "name": "int32_number_array_uses_int_value",
      "class": "SGInt32Array",
      "superclass": "SGIntArray",
      "width": 4,
      "number_values": [
        4294967297,
        -4294967297
      ],
      "expected_data_hex": "01000000ffffffff",
      "expected_count": 2
    },
    {
      "name": "int64_number_array_uses_long_value",
      "class": "SGInt64Array",
      "superclass": "SGLongArray",
      "width": 8,
      "number_values": [
        9223372036854775807,
        -9223372036854775808
      ],
      "expected_data_hex": "ffffffffffffff7f0000000000000080",
      "expected_count": 2
    },
    {
      "name": "empty_int32_values",
      "class": "SGInt32Array",
      "superclass": "SGIntArray",
      "width": 4,
      "values": [],
      "expected_data_hex": "",
      "expected_count": 0
    },
    {
      "name": "empty_int64_number_array",
      "class": "SGInt64Array",
      "superclass": "SGLongArray",
      "width": 8,
      "number_values": [],
      "expected_data_hex": "",
      "expected_count": 0
    },
    {
      "name": "nil_number_array_initializes_empty",
      "class": "SGInt32Array",
      "superclass": "SGIntArray",
      "width": 4,
      "number_values": null,
      "expected_data_hex": "",
      "expected_count": 0
    }
  ],
  "gaps": [
    "superclass init failure behavior is not runtime-executed",
    "out-of-range numberAtIndex reads are unchecked and remain an explicit safety gap",
    "nil element behavior inside a nonnil NSArray is not used as a production policy"
  ],
  "element_cases": [
    {
      "name": "ll_above_int32",
      "factory": "numberWithLongLong",
      "class": "__NSCFNumber",
      "objc_type": "q",
      "int64_value": 4294967297,
      "expected_int": 1,
      "expected_long": 4294967297
    },
    {
      "name": "ll_negative_above",
      "factory": "numberWithLongLong",
      "class": "__NSCFNumber",
      "objc_type": "q",
      "int64_value": -4294967297,
      "expected_int": -1,
      "expected_long": -4294967297
    },
    {
      "name": "ll_max",
      "factory": "numberWithLongLong",
      "class": "__NSCFNumber",
      "objc_type": "q",
      "int64_value": 9223372036854775807,
      "expected_int": -1,
      "expected_long": 9223372036854775807
    },
    {
      "name": "ll_min",
      "factory": "numberWithLongLong",
      "class": "__NSCFNumber",
      "objc_type": "q",
      "int64_value": -9223372036854775808,
      "expected_int": 0,
      "expected_long": -9223372036854775808
    },
    {
      "name": "double_fraction",
      "factory": "numberWithDouble",
      "class": "__NSCFNumber",
      "objc_type": "d",
      "double_bits": "0000000000000e40",
      "expected_int": 3,
      "expected_long": 3
    },
    {
      "name": "double_negative_fraction",
      "factory": "numberWithDouble",
      "class": "__NSCFNumber",
      "objc_type": "d",
      "double_bits": "0000000000000ec0",
      "expected_int": -3,
      "expected_long": -3
    },
    {
      "name": "double_large",
      "factory": "numberWithDouble",
      "class": "__NSCFNumber",
      "objc_type": "d",
      "double_bits": "a55cc3f129633d48",
      "expected_int": -1,
      "expected_long": 9223372036854775807
    },
    {
      "name": "double_negative_large",
      "factory": "numberWithDouble",
      "class": "__NSCFNumber",
      "objc_type": "d",
      "double_bits": "a55cc3f129633dc8",
      "expected_int": 0,
      "expected_long": -9223372036854775808
    },
    {
      "name": "double_pos_inf",
      "factory": "numberWithDouble",
      "class": "__NSCFNumber",
      "objc_type": "d",
      "double_bits": "000000000000f07f",
      "expected_int": -1,
      "expected_long": 9223372036854775807
    },
    {
      "name": "double_neg_inf",
      "factory": "numberWithDouble",
      "class": "__NSCFNumber",
      "objc_type": "d",
      "double_bits": "000000000000f0ff",
      "expected_int": 0,
      "expected_long": -9223372036854775808
    },
    {
      "name": "double_nan",
      "factory": "numberWithDouble",
      "class": "__NSCFNumber",
      "objc_type": "d",
      "double_bits": "000000000000f87f",
      "expected_int": 0,
      "expected_long": 0
    },
    {
      "name": "bool_true",
      "factory": "numberWithBool",
      "class": "__NSCFBoolean",
      "objc_type": "c",
      "bool_value": true,
      "expected_int": 1,
      "expected_long": 1
    },
    {
      "name": "bool_false",
      "factory": "numberWithBool",
      "class": "__NSCFBoolean",
      "objc_type": "c",
      "bool_value": false,
      "expected_int": 0,
      "expected_long": 0
    },
    {
      "name": "string_decimal",
      "factory": "initWithUTF8String",
      "class": "NSTaggedPointerString",
      "objc_type": "-",
      "string_value": "42",
      "expected_int": 42,
      "expected_long": 42
    },
    {
      "name": "string_fraction",
      "factory": "initWithUTF8String",
      "class": "NSTaggedPointerString",
      "objc_type": "-",
      "string_value": "-3.75",
      "expected_int": -3,
      "expected_long": -3
    },
    {
      "name": "string_invalid",
      "factory": "initWithUTF8String",
      "class": "NSTaggedPointerString",
      "objc_type": "-",
      "string_value": "nope",
      "expected_int": 0,
      "expected_long": 0
    },
    {
      "name": "nsnull",
      "factory": "NSNull",
      "class": "NSNull",
      "objc_type": "-",
      "expected_error": "NSInvalidArgumentException"
    },
    {
      "name": "array",
      "factory": "NSArray",
      "class": "NSConstantArray",
      "objc_type": "-",
      "expected_error": "NSInvalidArgumentException"
    },
    {
      "name": "dictionary",
      "factory": "NSDictionary",
      "class": "NSConstantDictionary",
      "objc_type": "-",
      "expected_error": "NSInvalidArgumentException"
    }
  ]
}
