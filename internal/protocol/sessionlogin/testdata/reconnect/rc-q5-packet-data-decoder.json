  "bson_decoder": {
    "status": "reviewed-static-unexecuted-runtime",
    "cases": [
      {
        "name": "empty_document",
        "expected_dictionary": [],
        "expected_stop": "terminator_stops_element_loop",
        "bson_hex": "0500000000",
        "expected_cursor_steps": [
          0
        ]
      },
      {
        "name": "signed_scalar_fields",
        "expected_dictionary": [
          "revision=-1:int32",
          "count=4294967296:int64"
        ],
        "expected_stop": "terminator_stops_element_loop",
        "bson_hex": "22000000107265766973696f6e00ffffffff12636f756e7400000000000100000000",
        "expected_cursor_steps": [
          14,
          15,
          0
        ]
      },
      {
        "name": "terminator_ignores_coalesced_trailing_bytes",
        "expected_dictionary": [
          "method=HINT:string"
        ],
        "expected_stop": "terminator_stops_element_loop",
        "bson_hex": "16000000026d6574686f64000500000048494e540000ffeedd",
        "expected_cursor_steps": [
          17,
          0
        ]
      },
      {
        "name": "unknown_type_returns_accumulated_dictionary",
        "expected_dictionary": [
          "method=HINT:string"
        ],
        "expected_stop": "unknown_type_stops_with_partial_dictionary",
        "bson_hex": "00000000026d6574686f64000500000048494e54007f62616400",
        "expected_cursor_steps": [
          17
        ]
      },
      {
        "name": "duplicate_key_replaces_prior_value",
        "bson_hex": "1b000000107800010000001078000200000000",
        "expected_cursor_steps": [
          7,
          7,
          0
        ],
        "expected_dictionary": [
          "x=2:int32"
        ],
        "expected_stop": "terminator_stops_element_loop"
      },
      {
        "name": "null_value_keeps_empty_dictionary",
        "bson_hex": "080000000a720000",
        "expected_cursor_steps": [
          3,
          0
        ],
        "expected_dictionary": [],
        "expected_stop": "terminator_stops_element_loop"
      },
      {
        "name": "null_value_continues_to_following_field",
        "bson_hex": "100000000a7200107072000300000000",
        "expected_cursor_steps": [
          3,
          8,
          0
        ],
        "expected_dictionary": [
          "pr=3:int32"
        ],
        "expected_stop": "terminator_stops_element_loop"
      },
      {
        "name": "null_duplicate_preserves_prior_value",
        "bson_hex": "170000001072000c0000000a7200107072000300000000",
        "expected_cursor_steps": [
          7,
          3,
          8,
          0
        ],
        "expected_dictionary": [
          "r=12:int32",
          "pr=3:int32"
        ],
        "expected_stop": "terminator_stops_element_loop"
      },
      {
        "name": "value_after_null_is_inserted",
        "bson_hex": "0f0000000a72001072000c00000000",
        "expected_cursor_steps": [
          3,
          7,
          0
        ],
        "expected_dictionary": [
          "r=12:int32"
        ],
        "expected_stop": "terminator_stops_element_loop"
      },
      {
        "name": "undefined_duplicate_preserves_prior_value",
        "bson_hex": "170000001072000c000000067200107072000300000000",
        "expected_cursor_steps": [
          7,
          3,
          8,
          0
        ],
        "expected_dictionary": [
          "r=12:int32",
          "pr=3:int32"
        ],
        "expected_stop": "terminator_stops_element_loop"
      }
    ]
  }
