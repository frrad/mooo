{
  "schema": "session-login-token-helper-v1",
  "status": "RED contract vectors; no production reducer",
  "vectors": [
    {
      "name": "strict token advance dispatches token write",
      "kind": "token",
      "current": 41,
      "incoming": 42,
      "expect": ["compare_strict_greater", "open_nested_context", "dispatch_context_block", "set_token"]
    },
    {
      "name": "equal token skips nested context",
      "kind": "token",
      "current": 42,
      "incoming": 42,
      "expect": ["no_effect"]
    },
    {
      "name": "lower token skips nested context",
      "kind": "token",
      "current": 42,
      "incoming": 41,
      "expect": ["no_effect"]
    },
    {
      "name": "negative token to zero is typed assertion error",
      "kind": "token",
      "current": -1,
      "incoming": 0,
      "expect": ["observed_assertion_boundary", "typed_error_decision"]
    },
    {
      "name": "existing cursor relation may update loss check before token write",
      "kind": "token",
      "current": 41,
      "incoming": 42,
      "existingLossCheckPositive": true,
      "existingTokenEqualsLossCheck": true,
      "expect": ["existing_loss_check_positive_guard", "existing_token_equality_probe", "set_loss_check_if_equal", "set_token"]
    },
    {
      "name": "nonpositive loss check skips auxiliary setter",
      "kind": "token",
      "current": 41,
      "incoming": 42,
      "existingLossCheckPositive": false,
      "existingTokenEqualsLossCheck": true,
      "expect": ["skip_loss_check_setter", "set_token"]
    },
    {
      "name": "loss check mismatch skips auxiliary setter",
      "kind": "token",
      "current": 41,
      "incoming": 42,
      "existingLossCheckPositive": true,
      "existingTokenEqualsLossCheck": false,
      "expect": ["skip_loss_check_setter", "set_token"]
    },
    {
      "name": "strict blind advance dispatches blind write",
      "kind": "blind",
      "current": 7,
      "incoming": 8,
      "expect": ["compare_strict_greater", "open_nested_context", "dispatch_context_block", "set_blind"]
    },
    {
      "name": "equal blind skips nested context",
      "kind": "blind",
      "current": 8,
      "incoming": 8,
      "expect": ["no_effect"]
    },
    {
      "name": "blind zero has no observed token assertion branch",
      "kind": "blind",
      "current": -1,
      "incoming": 0,
      "expect": ["compare_strict_greater", "perform_blind_write"]
    },
    {
      "name": "current queue invokes block inline",
      "kind": "token",
      "current": 1,
      "incoming": 2,
      "nestedContext": "current_queue",
      "expect": ["dispatch_context_block", "invoke_block_inline", "set_token"]
    },
    {
      "name": "other queue wraps and waits for operation",
      "kind": "token",
      "current": 1,
      "incoming": 2,
      "nestedContext": "other_queue",
      "expect": ["dispatch_context_block", "wrap_write_operation", "invoke_block", "set_token", "process_changed_objects", "wait_for_operation"]
    },
    {
      "name": "missing nested context exposes storage gap",
      "kind": "token",
      "current": 1,
      "incoming": 2,
      "nestedContext": "missing",
      "expect": ["skip_block", "context_failure_behavior_unresolved"]
    },
    {
      "name": "missing operation queue exposes storage gap",
      "kind": "token",
      "current": 1,
      "incoming": 2,
      "nestedContext": "missing_queue",
      "expect": ["skip_block", "context_failure_behavior_unresolved"]
    },
    {
      "name": "commit and restart durability remain unresolved",
      "kind": "token",
      "current": 1,
      "incoming": 2,
      "expect": ["durable_commit_unresolved", "reset_policy_unresolved"]
    }
  ]
}
