{
  "schema": "session-login-token-cursor-v1",
  "status": "RED contract vectors; no production reducer",
  "vectors": [
    {
      "name": "greater int64 token advances",
      "currentTokenId": 41,
      "incomingTokenId": 42,
      "currentLBK": 7,
      "incomingLBK": 7,
      "expect": [
        "token_update_selected",
        "no_lbk_update_selected"
      ]
    },
    {
      "name": "equal int64 token is ignored",
      "currentTokenId": 42,
      "incomingTokenId": 42,
      "expect": [
        "no_token_update_selected"
      ]
    },
    {
      "name": "lower int64 token is ignored",
      "currentTokenId": 42,
      "incomingTokenId": 41,
      "expect": [
        "no_token_update_selected"
      ]
    },
    {
      "name": "greater int32 blind cursor advances independently",
      "currentTokenId": 42,
      "incomingTokenId": 42,
      "currentLBK": 7,
      "incomingLBK": 8,
      "expect": [
        "no_token_update_selected",
        "lbk_update_selected"
      ]
    },
    {
      "name": "lower blind cursor is ignored independently",
      "currentTokenId": 42,
      "incomingTokenId": 42,
      "currentLBK": 8,
      "incomingLBK": 7,
      "expect": [
        "no_token_update_selected",
        "no_lbk_update_selected"
      ]
    },
    {
      "name": "lower login cursor requires explicit profile policy",
      "currentTokenId": 900,
      "incomingTokenId": 12,
      "profileGeneration": "unknown",
      "expect": [
        "request_reset_or_ignore_policy",
        "never_implicit_global_replace"
      ]
    },
    {
      "name": "signed int64 negative domain advances strictly",
      "currentTokenId": -2,
      "incomingTokenId": -1,
      "expect": [
        "token_update_selected"
      ]
    },
    {
      "name": "signed int64 negative equal is ignored",
      "currentTokenId": -1,
      "incomingTokenId": -1,
      "expect": [
        "no_token_update_selected"
      ]
    },
    {
      "name": "signed int64 positive to negative is lower",
      "currentTokenId": 1,
      "incomingTokenId": -1,
      "expect": [
        "no_token_update_selected"
      ]
    },
    {
      "name": "signed int32 negative blind domain advances strictly",
      "currentLBK": -2,
      "incomingLBK": -1,
      "expect": [
        "lbk_update_selected"
      ]
    },
    {
      "name": "negative current with zero incoming takes observed assertion branch",
      "currentTokenId": -1,
      "incomingTokenId": 0,
      "expect": [
        "token_assertion_abort_observed",
        "no_update_selected"
      ],
      "implementationDecision": "return_error_without_process_abort"
    }
  ]
}
