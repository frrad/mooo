{
  "provenance": {
    "kind": "static",
    "client": "KakaoTalk for Mac 26.8.0 field model; mooo diagnostic extraction rules",
    "date": "2026-10-17",
    "method": "Synthetic bodies built from the field names, types and value ranges in research/web-error-bodies.md (WEB-BIN-001, WEB-LIVE-001, and the body reported in frrad/mooo#424). safe_to_log follows that document's extraction rules, which are a mooo implementation decision: the official client logs nothing from these bodies and has no equivalent function.",
    "doc": "research/web-error-bodies.md"
  },
  "rules": [
    "Extract only from a body that is exactly one UTF-8 JSON object with no duplicate keys at any depth and no trailing data. Otherwise extract nothing.",
    "status: a JSON integer literal (no fraction or exponent) from -9999999 to 9999999.",
    "reason: a string matching ^[A-Z][A-Z_]{0,63}$ after JSON unescaping.",
    "reason.detailCode: when reason is an object, its detailCode under the status rule. Nothing else is read from the object.",
    "code: a string matching ^[0-9]{1,7}$, or a JSON integer under the status rule. A string stays a string.",
    "Only top-level status, reason, code and reason.detailCode are ever extracted. Every other field, nested object or rejected value is dropped.",
    "A field absent from safe_to_log must be absent from the diagnostic, not rendered as an empty value or the literal text null."
  ],
  "cases": [
    {
      "name": "reported-pilsner-400-code-and-reason",
      "http_status": 400,
      "headers": {"content-type": "application/json"},
      "body": "{\"code\":\"90008\",\"reason\":\"INVALID_REQUEST\"}",
      "safe_to_log": {"code": "90008", "reason": "INVALID_REQUEST"},
      "never_log": []
    },
    {
